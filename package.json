{
  "name": "cashflow",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Household checking-account cash flow forecaster",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning src/server/main.ts",
    "seed": "node --disable-warning=ExperimentalWarning src/server/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.ts",
    "import": "python -I scripts/import_xlsx.py",
    "setup-token": "node --disable-warning=ExperimentalWarning scripts/setup-token.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
