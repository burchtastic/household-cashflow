# Copy to private/deploy.env (gitignored) and fill in. Read by deploy/update.sh and
# deploy/setup-app-updates.sh, which run from your PC.
PVE_HOST=root@192.168.1.10                 # your Proxmox host
CT_ID=103                                  # the cashflow container's ID
REPO=your-github-name/cashflow             # your copy of this repo
APP_HOST=cashflow.your-tailnet.ts.net      # tailscale serve status shows it
